# JARVIS — optional local settings
# Model authentication is never configured here. The bridge reuses the existing
# `codex login` ChatGPT session and explicitly ignores OPENAI_API_KEY.

# JARVIS_BRIDGE_PORT=8787
# JARVIS_ALLOWED_ORIGINS=
# JARVIS_CODEX_MODEL=gpt-5.6-sol
# JARVIS_FAST_EFFORT=low
# JARVIS_STRONG_EFFORT=high
# JARVIS_TURN_TIMEOUT_MS=120000
# JARVIS_TOOL_TIMEOUT_MS=120000
# JARVIS_SESSION_TURNS=24
# JARVIS_SESSION_CHARS=40000
# JARVIS_CHROME_PORT=9223
# JARVIS_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Frontend connection. The bridge binds only to 127.0.0.1.
# VITE_BRIDGE_URL=ws://127.0.0.1:8787
# VITE_TTS_ENGINE=system
# VITE_KOKORO_VOICE=bm_george

# Optional non-OpenAI speech service. This key is read only by the local bridge,
# never sent to browser JavaScript, and is not read from Claude configuration.
# ELEVENLABS_API_KEY=
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
